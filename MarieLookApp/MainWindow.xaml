<Window x:Class="MarieLookApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="Marie LookApp"
        Width="0" Height="0"
        WindowStyle="None"
        ShowInTaskbar="False"
        Visibility="Hidden">

    <Grid>
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="Marie LookApp - Ctrl+Shift+L to search"
                        MenuActivation="RightClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Search (Ctrl+Shift+L)" Click="OnSearchClick"/>
                    <MenuItem Header="Sync Phrases" Click="OnSyncClick"/>
                    <Separator/>
                    <MenuItem Header="Logout" Click="OnLogoutClick"/>
                    <MenuItem Header="Exit" Click="OnExitClick"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
