<Window x:Class="MarieLookApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Marie LookApp - Login"
        Width="400" Height="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Marie LookApp"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,5"/>

        <TextBlock Grid.Row="1"
                   Text="Sign in with your email"
                   FontSize="14"
                   Foreground="#666"
                   Margin="0,0,0,20"/>

        <!-- Email Input -->
        <StackPanel Grid.Row="2" x:Name="EmailPanel">
            <TextBlock Text="Email" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
            <TextBox x:Name="EmailBox"
                     Style="{StaticResource ModernTextBox}"
                     Margin="0,0,0,15"/>
            <Button x:Name="SendOtpButton"
                    Content="Send Code"
                    Style="{StaticResource ModernButton}"
                    Click="OnSendOtpClick"/>
        </StackPanel>

        <!-- OTP Input -->
        <StackPanel Grid.Row="3" x:Name="OtpPanel" Visibility="Collapsed">
            <TextBlock Text="Enter the code sent to your email"
                       FontSize="12"
                       Foreground="#666"
                       Margin="0,0,0,5"/>
            <TextBox x:Name="OtpBox"
                     Style="{StaticResource ModernTextBox}"
                     MaxLength="8"
                     Margin="0,0,0,15"/>
            <Button x:Name="VerifyButton"
                    Content="Verify"
                    Style="{StaticResource ModernButton}"
                    Click="OnVerifyClick"/>
            <Button Content="Back"
                    Background="Transparent"
                    Foreground="#666"
                    BorderThickness="0"
                    Margin="0,10,0,0"
                    Cursor="Hand"
                    Click="OnBackClick"/>
        </StackPanel>

        <!-- Status -->
        <TextBlock Grid.Row="4"
                   x:Name="StatusText"
                   FontSize="12"
                   Foreground="#D32F2F"
                   TextWrapping="Wrap"
                   Margin="0,15,0,0"/>
    </Grid>
</Window>
