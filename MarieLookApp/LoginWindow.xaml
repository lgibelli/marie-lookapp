<Window x:Class="MarieLookApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Marie LookApp - Login"
        Width="400" Height="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Marie LookApp"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,5"/>

        <TextBlock Grid.Row="1"
                   Text="Sign in with your email"
                   FontSize="14"
                   Foreground="#666"
                   Margin="0,0,0,20"/>

        <!-- Email Input -->
        <StackPanel Grid.Row="2" x:Name="EmailPanel"
                    Visibility="{Binding IsEmailStep, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Email" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
            <TextBox x:Name="EmailBox"
                     Style="{StaticResource ModernTextBox}"
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,15"/>
            <Button Content="Send Code"
                    Style="{StaticResource ModernButton}"
                    Command="{Binding SendOtpCommand}"/>
        </StackPanel>

        <!-- OTP Input -->
        <StackPanel Grid.Row="3" x:Name="OtpPanel"
                    Visibility="{Binding IsOtpStep, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Enter the code sent to your email"
                       FontSize="12"
                       Foreground="#666"
                       Margin="0,0,0,5"/>
            <TextBox x:Name="OtpBox"
                     Style="{StaticResource ModernTextBox}"
                     Text="{Binding Otp, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="8"
                     Margin="0,0,0,15"/>
            <Button Content="Verify"
                    Style="{StaticResource ModernButton}"
                    Command="{Binding VerifyCommand}"/>
            <Button Content="Back"
                    Background="Transparent"
                    Foreground="#666"
                    BorderThickness="0"
                    Margin="0,10,0,0"
                    Cursor="Hand"
                    Command="{Binding BackCommand}"/>
        </StackPanel>

        <!-- Status -->
        <TextBlock Grid.Row="4"
                   x:Name="StatusText"
                   Text="{Binding StatusText}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,15,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="Gray"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Foreground" Value="#D32F2F"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</Window>
