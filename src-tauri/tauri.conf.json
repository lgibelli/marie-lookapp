{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marie Lookup",
  "version": "0.1.0",
  "identifier": "com.marie.lookup",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "lookup",
        "url": "index.html",
        "title": "Marie Lookup",
        "width": 680,
        "height": 460,
        "minWidth": 480,
        "minHeight": 320,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "center": true,
        "resizable": true,
        "focus": false,
        "shadow": true
      },
      {
        "label": "manage",
        "url": "manage.html",
        "title": "Marie Lookup — Manage Entries",
        "width": 900,
        "height": 640,
        "minWidth": 600,
        "minHeight": 400,
        "visible": false,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
