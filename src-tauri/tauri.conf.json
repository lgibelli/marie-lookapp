{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marie Lookup",
  "version": "2.0.0-rc.12",
  "identifier": "com.marie.lookup",
  "build": {
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzQTFBRDREMTREMTgxRkMKUldUOGdkRVVUYTJoUSsyUkxZa2ZJcW5LK3R2ZzBNWTZQTFhQNnM2c3pXZEFwY0gwSTU0a3ZpTUwK",
      "endpoints": [
        "https://github.com/lgibelli/marie-lookapp-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "lookup",
        "url": "index.html",
        "title": "Marie Lookup",
        "width": 680,
        "height": 460,
        "minWidth": 480,
        "minHeight": 320,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "center": true,
        "resizable": true,
        "focus": false,
        "shadow": true
      },
      {
        "label": "manage",
        "url": "manage.html",
        "title": "Marie Lookup — Manage Entries",
        "width": 900,
        "height": 640,
        "minWidth": 600,
        "minHeight": 400,
        "visible": false,
        "center": true,
        "resizable": true
      },
      {
        "label": "startup",
        "url": "startup.html",
        "title": "Marie Lookup",
        "width": 440,
        "height": 330,
        "visible": false,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
