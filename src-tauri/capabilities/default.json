{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for lookup, manage and startup windows",
  "windows": ["lookup", "manage", "startup"],
  "permissions": [
    "core:default",
    "autostart:default",
    "updater:default",
    "dialog:default",
    "core:window:allow-show",
    "core:window:allow-hide"
  ]
}
